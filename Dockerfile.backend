# ────────────────────────────────────────────────────────────────────────────
# Classroom CCTV Monitor – Backend Dockerfile
#
# GPU variant: swap the FROM line for:
#   FROM nvidia/cuda:12.3.1-cudnn8-runtime-ubuntu22.04
# and also replace onnxruntime → onnxruntime-gpu in requirements.txt.
# ────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

# System packages needed by OpenCV, MediaPipe, InsightFace
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libgomp1 \
        libgstreamer1.0-0 \
        curl \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps (cached layer – invalidated only when requirements change)
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY backend/   ./backend/
COPY scripts/   ./scripts/
COPY .env.example .env

# Data directories (bind-mounted at runtime; created here for standalone use)
RUN mkdir -p data/videos/enrollment \
             data/student_photos \
             data/embeddings_cache \
             logs

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--loop", "asyncio"]
