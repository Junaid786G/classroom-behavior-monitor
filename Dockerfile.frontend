# ────────────────────────────────────────────────────────────────────────────
# Classroom CCTV Monitor – Frontend Dockerfile (Streamlit)
# ────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim

# System deps for opencv-python-headless (used in Admin enroll-from-video tab)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install only the packages the frontend actually imports
# (avoids pulling in insightface / onnxruntime / mediapipe / celery)
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir \
    streamlit==1.35.0 \
    plotly==5.22.0 \
    pandas==2.2.2 \
    requests==2.32.2 \
    websocket-client==1.8.0 \
    opencv-python-headless==4.10.0.84 \
    numpy==1.26.4 \
    Pillow==10.3.0 \
    python-dotenv==1.0.1

# Copy frontend source
COPY frontend/ ./frontend/

# The pinned theme, and it has to come along. Streamlit reads .streamlit/
# config.toml relative to the WORKING DIRECTORY, which is /app here, so this
# lands where `streamlit run frontend/app.py` will look for it. Without it the
# container falls back to resolving the theme from the viewer's browser, and a
# dark-mode browser paints st.dataframe's canvas near-white on the near-white
# background main.css forces — see the comment in the file itself.
COPY .streamlit/ ./.streamlit/

# Streamlit config – disable telemetry and the default light theme
RUN mkdir -p /root/.streamlit && printf '\
[general]\n\
email = ""\n\
\n\
[browser]\n\
gatherUsageStats = false\n\
\n\
[server]\n\
headless = true\n\
enableCORS = false\n\
enableXsrfProtection = false\n\
' > /root/.streamlit/credentials.toml

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"

CMD ["streamlit", "run", "frontend/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.fileWatcherType=none", \
     "--browser.gatherUsageStats=false"]
