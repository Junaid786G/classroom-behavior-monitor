# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cm_user:cm_password@localhost:5432/classroom_monitor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Redis (task queue / caching) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Storage paths ───────────────────────────────────────────────────────────
VIDEO_STORAGE_PATH=./data/videos
STUDENT_PHOTOS_PATH=./data/student_photos
EMBEDDINGS_CACHE_PATH=./data/embeddings_cache
LOGS_PATH=./logs

# ─── Face recognition (InsightFace / ArcFace) ────────────────────────────────
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_CTX_ID=0
FACE_RECOGNITION_THRESHOLD=0.45
GALLERY_REBUILD_ON_STARTUP=false

# ─── Tracking (ByteTrack) ────────────────────────────────────────────────────
BYTETRACK_TRACK_THRESH=0.5
BYTETRACK_TRACK_BUFFER=30
BYTETRACK_MATCH_THRESH=0.8
BYTETRACK_FRAME_RATE=25

# ─── MediaPipe pose / behavior ───────────────────────────────────────────────
MEDIAPIPE_MODEL_COMPLEXITY=1
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5
ATTENTION_WINDOW_SECONDS=10
DISTRACTION_THRESHOLD_SECONDS=5

# ─── Pipeline ────────────────────────────────────────────────────────────────
PIPELINE_BATCH_SIZE=4
PIPELINE_SKIP_FRAMES=2
PIPELINE_MAX_WORKERS=4
ATTENDANCE_CONFIDENCE_THRESHOLD=0.70
ATTENDANCE_MIN_FRAMES=5

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
