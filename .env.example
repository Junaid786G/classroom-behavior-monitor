# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cm_user:cm_password@localhost:5432/classroom_monitor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Seed-account passwords. Each script aborts if the one it needs is unset - none
# of them will invent a credential. Leave blank here and set real values in your
# own .env; this file is committed, so nothing secret belongs in it.
#
# WHICH SCRIPT READS WHICH:
#   HOD_SEED_PASSWORD               03_migrate_multicourse.py, by that exact name
#   STUDENTS_SEED_PASSWORD          06_seed_student_logins.py, its default env
#   USER_SEED_PASSWORD              05_add_user.py, its DEFAULT env
#   INSTRUCTOR_SEED_PASSWORD        05_add_user.py --password-env INSTRUCTOR_SEED_PASSWORD
#   TRAINING_CONTROL_SEED_PASSWORD  05_add_user.py --password-env TRAINING_CONTROL_SEED_PASSWORD
#   STUDENT_SEED_PASSWORD           05_add_user.py --password-env, for ONE student login
#
# 05_add_user.py reads USER_SEED_PASSWORD unless told otherwise, so the two
# role-specific names above only work when passed explicitly:
#
#   USER_SEED_PASSWORD=... python scripts/05_add_user.py --username ahmed \
#       --role instructor --full-name "Dr. Ahmed"
#   python scripts/05_add_user.py --username trainingcontrol \
#       --role training_control --full-name "Training Control" \
#       --password-env TRAINING_CONTROL_SEED_PASSWORD
#
# STUDENTS_SEED_PASSWORD and STUDENT_SEED_PASSWORD differ by ONE CHARACTER and
# are not interchangeable - the plural seeds the whole roster through 06, the
# singular seeds one account through 05. 06_seed_student_logins.py carries the
# same warning at its DEFAULT_PASSWORD_ENV.
#
# Every name below except HOD_SEED_PASSWORD was absent from this file, so a fresh
# clone following DEPLOYMENT.md §B.6 could seed the HOD and nothing else - no
# instructor to run Live Monitor with, and no Training Control account, which is
# the one role that cannot be created through the UI it owns.
HOD_SEED_PASSWORD=
USER_SEED_PASSWORD=
INSTRUCTOR_SEED_PASSWORD=
TRAINING_CONTROL_SEED_PASSWORD=
STUDENTS_SEED_PASSWORD=
STUDENT_SEED_PASSWORD=

# ─── Redis (task queue / caching) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Storage paths ───────────────────────────────────────────────────────────
VIDEO_STORAGE_PATH=./data/videos
STUDENT_PHOTOS_PATH=./data/student_photos
EMBEDDINGS_CACHE_PATH=./data/embeddings_cache
LOGS_PATH=./logs

# ─── Face recognition (InsightFace / ArcFace) ────────────────────────────────
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_CTX_ID=0
FACE_RECOGNITION_THRESHOLD=0.45
GALLERY_REBUILD_ON_STARTUP=false

# ─── Tracking (ByteTrack) ────────────────────────────────────────────────────
BYTETRACK_TRACK_THRESH=0.5
BYTETRACK_TRACK_BUFFER=30
BYTETRACK_MATCH_THRESH=0.8
BYTETRACK_FRAME_RATE=25

# ─── MediaPipe pose / behavior ───────────────────────────────────────────────
MEDIAPIPE_MODEL_COMPLEXITY=1
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5
ATTENTION_WINDOW_SECONDS=10
DISTRACTION_THRESHOLD_SECONDS=5

# ─── Pipeline ────────────────────────────────────────────────────────────────
PIPELINE_BATCH_SIZE=4
PIPELINE_SKIP_FRAMES=2
PIPELINE_MAX_WORKERS=4
ATTENDANCE_CONFIDENCE_THRESHOLD=0.70
ATTENDANCE_MIN_FRAMES=5
# Minutes after a session starts before an arrival counts as LATE rather than
# PRESENT. The code default in backend/config.py is 10; 20 is what the deployed
# system actually runs, so it is stated here rather than left to the default.
LATE_THRESHOLD_MINUTES=20

# ─── Behaviour thresholds ────────────────────────────────────────────────────
# Every BEHAVIOR_* setting is deliberately ABSENT from this file: the defaults in
# backend/config.py are the tuned values, derived from real footage, and a
# half-copied set here would be a quiet way to detune the classifier.
#
# ONE OF THEM DOES NOT MATCH, AND IT IS A REAL DECISION, NOT AN OVERSIGHT:
#
#     BEHAVIOR_PITCH_HEAD_DOWN   code default 15.0   deployed .env 25.0
#
# A deployment that copies this file therefore runs head-down detection at 15
# degrees where the dev machine runs it at 25 - more sensitive, and more sessions
# flagged DISTRACTED for a student merely looking at their desk. Whether 15 or 25
# is right has not been settled against footage, and changing the default touches
# behaviour-classification config, so it is recorded here rather than silently
# reconciled. Set it explicitly in your .env if you want dev parity:
#
#     BEHAVIOR_PITCH_HEAD_DOWN=25.0
#
# The remaining BEHAVIOR_* values in the working .env all equal their code
# defaults - verified key by key - so only this one differs.

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
